# Environment Variables for WebZoneBW SC
# Copy this file to .env and configure for your deployment

# Production Environment
NODE_ENV=production

# API Configuration
VITE_API_URL=https://webzonebw.shop/api

# CORS Configuration
CORS_ORIGIN=https://webzonebw.shop

# Google AI API Key (Optional - for AI features)
GEMINI_API_KEY=your_gemini_api_key_here

# Session Configuration
SESSION_SECRET=your_session_secret_here

# Analytics (Optional)
GOOGLE_ANALYTICS_ID=G-L1KR6MWWP3

# Database (Optional - for production persistence)
DATABASE_URL=your_database_url_here
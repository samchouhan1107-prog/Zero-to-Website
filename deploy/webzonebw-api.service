[Unit]
Description=WebZoneBW API service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=webzonebw
Group=webzonebw
WorkingDirectory=/opt/webzonebw
EnvironmentFile=/etc/webzonebw/webzonebw.env
ExecStart=/usr/bin/node /opt/webzonebw/app.js
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/webzonebw/data

[Install]
WantedBy=multi-user.target
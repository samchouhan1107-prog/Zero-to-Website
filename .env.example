# WebZoneBW Backend Configuration
# Copy to .env and fill in values

# Server
PORT=3000
NODE_ENV=production

# CORS — your frontend domain
CORS_ORIGIN=https://webzonebw.shop

# Gemini AI (optional — falls back to built-in tutor if not set)
GEMINI_API_KEY=

# Frontend — set in .env for local dev (VITE_API_URL is embedded at build time)
# VITE_API_URL=https://webzonebw-api.onrender.com/api
